{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "venv",
        "venv/**",
        "venv_py314_backup",
        "venv_py314_backup/**",
        "__pycache__/**",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "*.local.json",
        "serviceAccountKey.json",
        ".env"
      ],
      "runtime": "python313"
    },
    {
      "source": "functions_ssr",
      "codebase": "ssr",
      "disallowLegacyRuntimeConfig": true,
      "predeploy": [
        "node \"$RESOURCE_DIR/scripts/sync-templates.js\""
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "runtime": "nodejs24"
    }
  ],
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/trading", "destination": "/dashboard", "type": 301 },
      { "source": "/purchase", "destination": "/pricing", "type": 301 },
      { "source": "/forecast", "destination": "/forecasting", "type": 302 },
      { "source": "/terminal", "destination": "/forecasting", "type": 302 },
      { "source": "/ticker-query", "destination": "/model-council", "type": 302 },
      { "source": "/ask-gpt-5", "destination": "/model-council", "type": 302 },
      { "source": "/ask-gpt5", "destination": "/model-council", "type": 302 },
      { "source": "/ask-gpt", "destination": "/model-council", "type": 302 },
      { "source": "/ai-leaderboard", "destination": "/explore", "type": 302 },
      { "source": "/leaderboard", "destination": "/explore", "type": 302 },
      { "source": "/ai-agent-leaderboard", "destination": "/explore", "type": 302 },
      { "source": "/blogs", "destination": "/blog", "type": 301 },
      { "source": "/events-calendar", "destination": "/events", "type": 302 },
      { "source": "/fx", "destination": "/forecasting?panel=fx", "type": 302 },
      { "source": "/terminal/fx", "destination": "/forecasting?panel=fx", "type": 302 },
      { "source": "/tools/fx", "destination": "/forecasting?panel=fx", "type": 302 }
    ],
    "rewrites": [
      { "source": "/blog", "destination": "/blog/index.html" },
      { "source": "/blog/posts/:slug", "destination": "/blog/posts/:slug.html" },
      { "source": "/blog/topics/:topic", "destination": "/blog/topics/:topic.html" },
      { "source": "/u/**", "destination": "/profile.html" },
      { "source": "/api/explore", "function": "quanturaExploreApi" },
      { "source": "/api/explore/**", "function": "quanturaExploreApi" },
      { "source": "/api/posts/**", "function": "quanturaExploreApi" },
      { "source": "/api/profile/**", "function": "quanturaExploreApi" },
      { "source": "/api/me/**", "function": "quanturaExploreApi" },
      { "source": "/api/follows/**", "function": "quanturaExploreApi" },
      { "source": "/api/watch-tickers/**", "function": "quanturaExploreApi" },
      { "source": "/api/notifications/**", "function": "quanturaExploreApi" },
      { "source": "/api/health", "function": "quanturaExploreApi" },
      { "source": "/api/llm/run", "function": "quanturaExploreApi" },
      { "source": "/api/llm/**", "function": "quanturaExploreApi" },
      { "source": "/api/mobile/auth/exchange", "function": "quanturaExploreApi" },
      { "source": "/api/mobile/play-integrity/verify", "function": "quanturaExploreApi" },
      { "source": "/api/analytics/ad-impression", "function": "quanturaExploreApi" },
      { "source": "/api/notify/sendTest", "function": "quanturaExploreApi" },
      { "source": "/api/earnings/refresh", "function": "quanturaExploreApi" },
      { "source": "/api/fx/convert", "function": "quanturaExploreApi" },
      { "source": "/api/indicators/analyze", "function": "quanturaExploreApi" },
      { "source": "/api/fiscaldata", "function": "quanturaExploreApi" },
      { "source": "/api/fiscaldata/**", "function": "quanturaExploreApi" },
      { "source": "/api/polymarket/search", "function": "quanturaExploreApi" },
      { "source": "/api/polymarket/price", "function": "quanturaExploreApi" },
      { "source": "/api/polymarket/active", "function": "quanturaExploreApi" },
      { "source": "/api/webhooks/inapppurchasesios", "function": "quanturaExploreApi" },
      { "source": "/api/webhooks/applenotifications", "function": "quanturaExploreApi" },
      { "source": "/api/webhooks/admob/reward", "function": "quanturaExploreApi" },
      { "source": "/api/webhook/admob/reward", "function": "quanturaExploreApi" },
      { "source": "/api/admob/reward", "function": "quanturaExploreApi" },
      { "source": "/webhooks/admob/reward", "function": "quanturaExploreApi" },
      { "source": "/webhook/admob/reward", "function": "quanturaExploreApi" },
      { "source": "/admob/reward", "function": "quanturaExploreApi" },
      { "source": "/api/shop", "function": "shopApi" },
      { "source": "/api/shop/**", "function": "shopApi" },
      { "source": "/api/saved", "function": "quanturaExploreApi" },
      { "source": "/api/saved/**", "function": "quanturaExploreApi" },
      { "source": "/api/my-requests", "function": "quanturaExploreApi" },
      { "source": "/api/my-requests/**", "function": "quanturaExploreApi" },
      { "source": "/api/shares/**", "function": "quanturaExploreApi" },
      { "source": "/api/auth/exchange", "function": "exchange_native_auth" },
