{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Quantura Developer Documentation",
  "favicon": "/favicon/favicon.svg",
  "logo": {
    "light": "/favicon/quantura-logo.svg",
    "dark": "/favicon/quantura-logo-dark.svg",
    "href": "https://quantura.studio"
  },
  "description": "Build with Quantura Forecast, interval-aware ensembles, market search and downloads, reproducible strategy research and workspace APIs.",
  "colors": {
    "primary": "#0B1526",
    "light": "#3AB5A2",
    "dark": "#08111F"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "seo": {
    "metatags": {
      "canonical": "https://quantura.mintlifysite.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "docs/index",
              "docs/get-started"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "docs/authentication",
              "docs/workspaces",
              "docs/workspace-collaboration",
              "docs/q-search",
              "docs/q-download",
              "docs/bigquery-public-data",
              "docs/ensemble-api",
              "docs/forecast-frequencies",
              "docs/historical-forecasts",
              "docs/screener-alerts",
              "docs/kalshi-perpetuals",
              "docs/q-support",
              "docs/mcp",
              "docs/errors",
              "docs/jev-forecast-questions"
            ]
          },
          {
            "group": "Algorithmic strategy research",
            "pages": [
              "docs/algorithmic-strategy",
              "docs/backtesting",
              "docs/data-provenance"
            ]
          },
          {
            "group": "Methodology and operations",
            "pages": [
              "docs/ensemble-forecasting",
              "docs/quantura-forecasts-methodology",
              "docs/quantura-forecasts-operations",
              "docs/alpaca-spy-options-worker",
              "docs/gitlab-observability",
              "docs/repository-size-maintenance"
            ]
          }
        ]
      },
      {
        "tab": "Endpoint reference",
        "openapi": {
          "source": "https://quantura.studio/api/openapi.json",
          "directory": "api-reference"
        }
