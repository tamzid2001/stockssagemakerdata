      { "source": "/api/email/send-newsletter-daily", "function": "send_newsletter_daily_http" },
      { "source": "/api/email/send-campaign", "function": "send_newsletter_daily_http" },
      { "source": "/api/email/send-newsletter-weekly", "function": "send_newsletter_daily_http" },
      { "source": "/email/unsubscribe", "function": "email_unsubscribe_http" },
      { "source": "/api/openai/models", "function": "api_openai_models" },
      { "source": "/api/model-council/providers", "function": "quanturaExploreApi" },
      { "source": "/api/model-council/models", "function": "quanturaExploreApi" },
      { "source": "/api/model-council/query", "function": "api_model_council_query" },
      { "source": "/api/model-council/improve-prompt", "function": "api_model_council_improve_prompt" },
      { "source": "/api/model-council/feedback", "function": "api_model_council_feedback" },
      { "source": "/api/model-council/share", "function": "api_model_council_share" },
      { "source": "/api/model-council/share/**", "function": "api_model_council_share" },
      { "source": "/api/ticker/intel", "function": "quanturaExploreApi" },
      { "source": "/api/ticker/trending", "function": "quanturaExploreApi" },
      { "source": "/api/market-headlines", "function": "quanturaExploreApi" },
      { "source": "/api/market-headlines/**", "function": "quanturaExploreApi" },
      { "source": "/api/ticker/modules", "function": "api_ticker_modules" },
      { "source": "/api/chat", "function": "api_chat" },
      { "source": "/", "function": "ssr" },
      { "source": "/forecasting", "function": "ssr" },
      { "source": "/forecast", "function": "ssr" },
      { "source": "/terminal", "function": "ssr" },
      { "source": "/ticker-intelligence", "function": "ssr" },
      { "source": "/predictions", "function": "ssr" },
      { "source": "/indicators", "function": "ssr" },
      { "source": "/trending", "function": "ssr" },
      { "source": "/news", "function": "ssr" },
      { "source": "/market-headlines", "function": "ssr" },
      { "source": "/model-council", "function": "ssr" },
      { "source": "/ticker-query", "function": "ssr" },
      { "source": "/ask-gpt-5", "function": "ssr" },
      { "source": "/ask-gpt5", "function": "ssr" },
      { "source": "/ask-gpt", "function": "ssr" },
      { "source": "/options", "function": "ssr" },
      { "source": "/saved-forecasts", "function": "ssr" },
      { "source": "/studio", "function": "ssr" },
      { "source": "/screener", "function": "ssr" },
      { "source": "/research", "function": "ssr" },
      { "source": "/about", "function": "ssr" },
      { "source": "/events", "function": "ssr" },
      { "source": "/pricing", "function": "ssr" },
      { "source": "/contact", "function": "ssr" },
      { "source": "/terms", "function": "ssr" },
      { "source": "/privacy", "function": "ssr" },
      { "source": "/disclaimer", "function": "ssr" },
      { "source": "/admin", "function": "ssr" },

      { "source": "/blog", "function": "ssr" },
      { "source": "/blog/posts/**", "function": "ssr" },

      { "source": "/dashboard", "function": "ssr" },
      { "source": "/dashboard/orders", "function": "ssr" },
      { "source": "/dashboard/profile", "function": "ssr" },
      { "source": "/dashboard/collaboration", "function": "ssr" },
      { "source": "/account", "function": "ssr" },
      { "source": "/watchlist", "function": "ssr" },
      { "source": "/productivity", "function": "ssr" },
      { "source": "/collaboration", "function": "ssr" },
      { "source": "/uploads", "function": "ssr" },
      { "source": "/autopilot", "function": "ssr" },
      { "source": "/notifications", "function": "ssr" },
      { "source": "/tools/fx", "function": "ssr" },
      { "source": "/ticker", "function": "ssr" },
      { "source": "/ticker/**", "function": "ssr" }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
