FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/opt/quantura/model-cache

WORKDIR /opt/quantura/app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-ensemble-forecast.lock ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements-ensemble-forecast.lock

COPY ensemble_forecasting ./ensemble_forecasting
COPY quantura_site/functions_explore/src/ensembleModelRegistry.json ./quantura_site/functions_explore/src/ensembleModelRegistry.json

RUN useradd --create-home --uid 10001 quantura \
    && mkdir -p /opt/quantura/model-cache \
    && chown -R quantura:quantura /opt/quantura

USER quantura

ENTRYPOINT ["python", "-m", "ensemble_forecasting.cli"]
