rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "tamzid257@gmail.com";
    }

    function isWorkspaceCollaborator(ownerId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(ownerId)/collaborators/$(request.auth.uid));
    }

    function collaboratorRole(ownerId) {
      return get(/databases/$(database)/documents/users/$(ownerId)/collaborators/$(request.auth.uid)).data.role;
    }

    function canEditWorkspace(ownerId) {
      return isSignedIn()
        && (request.auth.uid == ownerId || (isWorkspaceCollaborator(ownerId) && collaboratorRole(ownerId) == "editor"));
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /users/{userId}/collaborators/{collabId} {
      allow read: if isAdmin() || (isSignedIn() && (request.auth.uid == userId || request.auth.uid == collabId));
      allow write: if false;
    }

    match /users/{userId}/shared_workspaces/{workspaceId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if false;
    }

    match /users/{userId}/tasks/{taskId} {
      allow read: if isAdmin()
        || (isSignedIn() && (request.auth.uid == userId || isWorkspaceCollaborator(userId)));
      allow create, update, delete: if isAdmin() || canEditWorkspace(userId);
    }

    match /users/{userId}/calendar_interactions/{interactionId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if false;
    }

    // AWS role configuration is server-only. Authenticated clients use API
    // endpoints that verify their Firebase ID token and scope every operation
    // to users/{uid}/integrations/aws.
    match /users/{userId}/integrations/{integrationId} {
      allow read, write: if false;
    }

    match /users/{userId}/watchlist/{tickerId} {
      allow read: if isAdmin()
        || (isSignedIn() && (request.auth.uid == userId || isWorkspaceCollaborator(userId)));
      allow create, update, delete: if isAdmin() || canEditWorkspace(userId);
    }

    match /users/{userId}/price_alerts/{alertId} {
      allow read: if isAdmin()
        || (isSignedIn() && (request.auth.uid == userId || isWorkspaceCollaborator(userId)));
      allow create, update, delete: if isAdmin() || canEditWorkspace(userId);
    }

    match /users/{userId}/ai_agents/{agentId} {
      allow read: if isAdmin()
        || (isSignedIn() && (request.auth.uid == userId || isWorkspaceCollaborator(userId)));
      allow create, update, delete: if isAdmin() || canEditWorkspace(userId);
    }

    match /users/{userId}/ai_agent_followers/{docId} {
      allow read, create, update, delete: if isAdmin()
        || (isSignedIn() && (request.auth.uid == userId || isWorkspaceCollaborator(userId)));
    }

    match /users/{userId}/ai_agent_likes/{docId} {
      allow read, create, update, delete: if isAdmin()
        || (isSignedIn() && (request.auth.uid == userId || isWorkspaceCollaborator(userId)));
    }

    match /collab_invites/{inviteId} {
      allow read, write: if false;
    }

    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /forecast_requests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin()
        || (isSignedIn() && (request.auth.uid == resource.data.userId || isWorkspaceCollaborator(resource.data.userId)));
      allow update, delete: if isAdmin();
    }

    match /screener_runs/{runId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin()
        || (isSignedIn() && (request.auth.uid == resource.data.userId || isWorkspaceCollaborator(resource.data.userId)));
      allow update, delete: if isAdmin();
    }

    match /autopilot_requests/{requestId} {
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    // Forecast alert schedules and crossing state are server-only. The API
    // verifies Firebase ID tokens and enforces alert.userId ownership.
    match /forecast_price_alerts/{alertId} {
      allow read, write: if false;
    }

    match /forecast_price_alerts/{alertId}/events/{eventId} {
      allow read, write: if false;
    }

    match /prediction_uploads/{uploadId} {
      allow read, write: if isAdmin();
    }

    match /agent_runs/{runId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /feature_votes/{voteId} {
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /feature_vote_totals/{featureKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /backtests/{backtestId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /alpaca_orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /social_campaigns/{campaignId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    match /social_queue/{queueId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow write: if false;
    }

    match /social_dispatch_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if resource.data.visibility == "public"
        || (isSignedIn() && request.auth.uid == resource.data.authorUid);
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
    }

    match /posts/{postId}/comments/{commentId} {
      allow read: if exists(/databases/$(database)/documents/posts/$(postId))
        && (
          get(/databases/$(database)/documents/posts/$(postId)).data.visibility == "public"
          || (isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorUid)
        );
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
      allow update: if false;
    }

    match /postLikes/{postId}/users/{uid} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    match /postReposts/{postId}/users/{uid} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId}/follows/{authorUid} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/watchTickers/{ticker} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/fcmTokens/{token} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/requests/{requestId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId)
        || resource.data.share.visibility == "public";
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /request_shares/{slug} {
      allow read: if resource.data.visibility == "public"
        || resource.data.visibility == "unlisted"
        || (isSignedIn() && request.auth.uid == resource.data.ownerUid)
        || isAdmin();
      allow create: if isAdmin()
        || (isSignedIn() && request.auth.uid == request.resource.data.ownerUid);
      allow update, delete: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.ownerUid);
    }

    // Quantura Forecasts is server-owned. Public and enterprise consumers use
    // the redacted HTTP projections, never direct Firestore access.
    match /quantura_forecasts/{forecastId} {
      allow read, write: if false;

      match /probability_history/{revisionId} {
        allow read, write: if false;
      }

      match /amendments/{amendmentId} {
        allow read, write: if false;
      }
    }

    match /quantura_forecast_api_keys/{keyId} {
      allow read, write: if false;
    }

    match /quantura_forecast_api_usage/{requestId} {
      allow read, write: if false;
    }

    match /quantura_forecast_rate_windows/{windowId} {
      allow read, write: if false;
    }

    match /quantura_forecast_dataset_releases/{version} {
      allow read, write: if false;
    }

    match /quantura_forecast_job_runs/{runId} {
      allow read, write: if false;
    }

    match /quantura_forecast_aggregates/{aggregateId} {
      allow read, write: if false;
    }

    match /quantura_forecast_slugs/{slug} {
      allow read, write: if false;
    }

    // Heavy ensemble jobs, immutable inputs, results, presets, cache records,
    // idempotency mappings, and usage counters are only exposed through the
    // authenticated API. Workspace authorization is evaluated on every HTTP
    // request; browser clients never receive direct Firestore access.
    match /ensemble_forecast_jobs/{jobId} {
      allow read, write: if false;
      match /input_chunks/{chunkId} {
        allow read, write: if false;
      }
    }

    match /ensemble_forecast_results/{forecastId} {
      allow read, write: if false;
    }

    match /ensemble_forecast_presets/{presetId} {
      allow read, write: if false;
    }

    match /ensemble_forecast_cache/{cacheId} {
      allow read, write: if false;
    }

    match /ensemble_forecast_idempotency/{idempotencyId} {
      allow read, write: if false;
    }

    match /ensemble_forecast_usage/{usageId} {
      allow read, write: if false;
    }
  }
}
