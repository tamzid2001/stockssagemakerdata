# Quantura Example Environment File
#
# Use this file as a reference for the environment variables you may need.
# - Copy this file to `.env` for local development.
# - DO NOT commit `.env` (it should stay local and/or in your secret manager).
# - In production (Firebase Functions / Cloud Run), prefer Secret Manager / `firebase functions:secrets:set`.
#
# All values below are placeholders intentionally left blank.

# -----------------------------
# Core / Models
# -----------------------------
OPENAI_API_KEY=
PREDICTION_AGENT_MODEL=gpt-5-mini

# Amazon Nova (optional, only used when a Nova model is selected)
AMAZON_NOVA_API_KEY=
AMAZON_NOVA_API_ENDPOINT=
AMAZON_NOVA_DEFAULT_MODEL=amazon.nova-lite-v1:0

# Global server-side model allowlist (comma-separated)
LLM_ALLOWED_MODELS=gpt-5-nano,gpt-5-mini,gpt-5,gpt-5.1,gpt-5.2

# -----------------------------
# AWS (optional)
# -----------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# -----------------------------
# Slack (optional)
# -----------------------------
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=

# -----------------------------
# Alpaca (optional)
# -----------------------------
ALPACA_API_BASE=https://paper-api.alpaca.markets
ALPACA_DATA_BASE=https://data.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Legacy aliases (optional)
ALPACAAPIKEY=
ALPACASECRETKEY=

# -----------------------------
# Firebase Web Push (public VAPID key used by the browser to register tokens)
# -----------------------------
FCM_WEB_VAPID_KEY=

# -----------------------------
# Stripe (optional)
# -----------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_PLATFORM_FEE_PERCENT=12
CREATOR_DEFAULT_SUBSCRIBE_USD=9
CREATOR_DEFAULT_THANKS_USD=5

# -----------------------------
# Treasury Fiscal Data API
# -----------------------------
# No API key is required for https://api.fiscaldata.treasury.gov/

# -----------------------------
# Unsplash (optional)
# -----------------------------
UNSPLASH_ACCESS_KEY=

# -----------------------------
# X / Twitter (optional)
# -----------------------------
TWITTER_BEARER_TOKEN=
# OAuth 2.0 user-context token (preferred for posting)
X_USER_OAUTH2_TOKEN=
# OAuth 1.0a user-context (legacy; only if you still use it)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# -----------------------------
# Facebook / Instagram (optional)
# -----------------------------
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_DEFAULT_IMAGE_URL=https://images.unsplash.com/photo-1535320903710-d993d3d77d29?auto=format&fit=crop&w=1280&q=80

# -----------------------------
# TikTok (optional)
# -----------------------------
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_DEFAULT_MEDIA_URL=https://quantura.studio/web-app-manifest-512x512.png?v=20260405b
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# -----------------------------
# Social publishing (GitHub Actions + Google Cloud Secret Manager)
# -----------------------------
# These values are mainly for local dry-runs. Production social workflows should
# read provider credentials from Google Cloud Secret Manager using GitHub Actions OIDC.
SOCIAL_CONTENT_MODEL=gpt-5-mini
SOCIAL_AUTOMATION_TIMEZONE=America/New_York
SOCIAL_POSTING_TIMEZONE=America/New_York
SOCIAL_DEFAULT_CTA_URL=https://quantura.studio
GCP_PROJECT_ID=quantura-e2e3d
