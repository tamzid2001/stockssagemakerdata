{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Quantura Developer Documentation",
  "description": "Build with Quantura Forecast (Q Forecast), ensemble quantiles, collaborator-aware workspaces, the Uploaded CSV API, and licensed datasets.",
  "colors": {
    "primary": "#0B1526",
    "light": "#3AB5A2",
    "dark": "#08111F"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "seo": {
    "metatags": {
      "canonical": "https://quantura.mintlifysite.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "docs/index",
              "docs/get-started"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "docs/authentication",
              "docs/workspaces",
              "docs/workspace-collaboration",
              "docs/uploaded-csv-api",
              "docs/ensemble-api",
              "docs/mcp",
              "docs/data-provenance",
              "docs/errors"
            ]
          },
          {
            "group": "Methodology and operations",
            "pages": [
              "docs/ensemble-forecasting",
              "docs/quantura-forecasts-methodology",
              "docs/quantura-forecasts-operations",
              "docs/gitlab-observability",
              "docs/repository-size-maintenance"
            ]
          }
        ]
      },
      {
        "tab": "Endpoint reference",
        "openapi": {
          "source": "https://quantura.studio/api/openapi.json",
          "directory": "api-reference"
        }
      }
    ]
  }
}
