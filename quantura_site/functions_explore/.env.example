# Prediction-market credentials are server-side only. Never prefix these with
# NEXT_PUBLIC_ and never commit real values.

# Polymarket US SDK credentials
POLYMARKET_PUBLIC_KEY=
POLYMARKET_SECRET_KEY=

# Kalshi production API credentials, matching polymarketsfuturesbot. The
# standard KALSHI_API_KEY_ID name is also accepted as a compatibility alias.
KALSHI_PROD_API_KEY=
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
# Quantura Forecast Intelligence API (server-only)
QUANTURA_FORECAST_API_KEY_PEPPER=

# Aikido Zen Firewall (server-side only)
AIKIDO_TOKEN=
AIKIDO_BLOCK=false
# Set as NODE_OPTIONS in managed Express runtimes so Zen starts first.
AIKIDO_NODE_OPTIONS=-r @aikidosec/firewall/instrument

# GitLab Observability OTLP tracing (server-side only)
GITLAB_OBSERVABILITY_ENABLED=false
GITLAB_OTEL_HTTP_ENDPOINT=https://140928869.otel.gitlab-o11y.com:14318
GITLAB_PROJECT_ID=85909892
GITLAB_PROJECT_NAME=stockssagemakerdata
OTEL_SERVICE_NAME=quantura-api
GITLAB_SERVICE_VERSION=

# Durable ensemble dispatch and signed worker callbacks (server-only)
QUANTURA_ENSEMBLE_WORKER_TOKEN=
QUANTURA_ENSEMBLE_WORKER_MODE=github_actions
QUANTURA_ENSEMBLE_ALLOW_MANUAL_CLAIM=false
GITHUB_ACTIONS_TOKEN=
GITHUB_REPO_OWNER=tamzid2001
GITHUB_REPO_NAME=stockssagemakerdata
GITHUB_WORKFLOW_REF=main
# Hugging Face access and TimesFM commercial rights are separate gates.
TIMESFM_HF_ACCESS_APPROVED=false
TIMESFM_COMMERCIAL_LICENSED=false
ALLOW_NONCOMMERCIAL_TIMESFM=false
