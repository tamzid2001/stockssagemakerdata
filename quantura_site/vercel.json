{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/trading", "destination": "/dashboard", "permanent": true },
    { "source": "/purchase", "destination": "/pricing", "permanent": true },
    { "source": "/forecast", "destination": "/forecasting", "permanent": false },
    { "source": "/terminal", "destination": "/forecasting", "permanent": false },
    { "source": "/trending", "destination": "/forecasting", "permanent": false },
    { "source": "/ticker-intelligence", "destination": "/forecasting", "permanent": false },
    { "source": "/model-council", "destination": "/forecasting", "permanent": true },
    { "source": "/ticker-query", "destination": "/forecasting", "permanent": true },
    { "source": "/ask-gpt-5", "destination": "/forecasting", "permanent": true },
    { "source": "/ask-gpt5", "destination": "/forecasting", "permanent": true },
    { "source": "/ask-gpt", "destination": "/forecasting", "permanent": true },
    { "source": "/predictions", "destination": "/forecasting", "permanent": true },
    { "source": "/ai-leaderboard", "destination": "/dashboard", "permanent": false },
    { "source": "/leaderboard", "destination": "/dashboard", "permanent": false },
    { "source": "/ai-agent-leaderboard", "destination": "/dashboard", "permanent": false },
    { "source": "/blogs", "destination": "/blog", "permanent": true },
    { "source": "/events-calendar", "destination": "/events", "permanent": false },
    { "source": "/dashboard/uploads", "destination": "/autopilot", "permanent": false },
    { "source": "/fx", "destination": "/forecasting", "permanent": true },
    { "source": "/terminal/fx", "destination": "/forecasting", "permanent": true },
    { "source": "/tools/fx", "destination": "/forecasting", "permanent": true },
    { "source": "/currency-conversion", "destination": "/forecasting", "permanent": true },
    { "source": "/explore", "destination": "/forecasting", "permanent": true },
    { "source": "/indicators", "destination": "/forecasting", "permanent": true },
    { "source": "/studio", "destination": "/research", "permanent": true },
    { "source": "/watchlist", "destination": "/notifications", "permanent": true },
    { "source": "/profile", "destination": "/account", "permanent": true },
    { "source": "/u/:path*", "destination": "/account", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/callable/:path*", "destination": "https://quantura-legacy-api.vercel.app/api/callable/:path*" },
    { "source": "/api/auth/exchange", "destination": "https://quantura-legacy-api.vercel.app/api/auth/exchange" },
    { "source": "/api/auth/exchange-native-id-token", "destination": "https://quantura-legacy-api.vercel.app/api/auth/exchange-native-id-token" },
    { "source": "/api/openai/models", "destination": "https://quantura-legacy-api.vercel.app/api/openai/models" },
    { "source": "/api/ticker/modules", "destination": "https://quantura-legacy-api.vercel.app/api/ticker/modules" },
    { "source": "/api/chat", "destination": "https://quantura-legacy-api.vercel.app/api/chat" },
    { "source": "/api/stripe/webhook", "destination": "https://quantura-legacy-api.vercel.app/api/stripe/webhook" },
    { "source": "/api/email/:path*", "destination": "https://quantura-newsletter.vercel.app/api/email/:path*" },
    { "source": "/email/unsubscribe", "destination": "https://quantura-newsletter.vercel.app/email/unsubscribe" },
    { "source": "/api/:path*", "destination": "https://quantura-api.vercel.app/api/:path*" },
    { "source": "/webhooks/:path*", "destination": "https://quantura-api.vercel.app/webhooks/:path*" },
    { "source": "/webhook/:path*", "destination": "https://quantura-api.vercel.app/webhook/:path*" },
    { "source": "/admob/:path*", "destination": "https://quantura-api.vercel.app/admob/:path*" },
    { "source": "/", "destination": "https://quantura-ssr.vercel.app/" },
    { "source": "/forecasting", "destination": "https://quantura-ssr.vercel.app/forecasting" },
    { "source": "/autopilot", "destination": "https://quantura-ssr.vercel.app/autopilot" },
    { "source": "/uploads", "destination": "https://quantura-ssr.vercel.app/uploads" },
    { "source": "/sports-forecasting", "destination": "https://quantura-ssr.vercel.app/sports-forecasting" },
    { "source": "/news", "destination": "https://quantura-ssr.vercel.app/news" },
    { "source": "/historical-data", "destination": "https://quantura-ssr.vercel.app/historical-data" },
    { "source": "/historical-prices", "destination": "https://quantura-ssr.vercel.app/historical-prices" },
    { "source": "/market-headlines", "destination": "https://quantura-ssr.vercel.app/market-headlines" },
    { "source": "/options", "destination": "https://quantura-ssr.vercel.app/options" },
    { "source": "/saved-forecasts", "destination": "https://quantura-ssr.vercel.app/saved-forecasts" },
    { "source": "/dashboard/:path*", "destination": "https://quantura-ssr.vercel.app/dashboard" },
    { "source": "/dashboard", "destination": "https://quantura-ssr.vercel.app/dashboard" },
    { "source": "/account", "destination": "https://quantura-ssr.vercel.app/account" },
    { "source": "/productivity", "destination": "https://quantura-ssr.vercel.app/productivity" },
    { "source": "/collaboration", "destination": "https://quantura-ssr.vercel.app/collaboration" },
    { "source": "/notifications", "destination": "https://quantura-ssr.vercel.app/notifications" },
    { "source": "/screener", "destination": "https://quantura-ssr.vercel.app/screener" },
    { "source": "/research", "destination": "https://quantura-ssr.vercel.app/research" },
    { "source": "/pricing", "destination": "https://quantura-ssr.vercel.app/pricing" },
    { "source": "/contact", "destination": "https://quantura-ssr.vercel.app/contact" },
    { "source": "/shop", "destination": "https://quantura-ssr.vercel.app/shop" },
    { "source": "/admin", "destination": "https://quantura-ssr.vercel.app/admin" },
    { "source": "/terms", "destination": "https://quantura-ssr.vercel.app/terms" },
    { "source": "/privacy", "destination": "https://quantura-ssr.vercel.app/privacy" },
    { "source": "/disclaimer", "destination": "https://quantura-ssr.vercel.app/disclaimer" },
    { "source": "/about", "destination": "https://quantura-ssr.vercel.app/about" },
    { "source": "/events", "destination": "https://quantura-ssr.vercel.app/events" },
    { "source": "/blog/:path*", "destination": "https://quantura-ssr.vercel.app/blog/:path*" },
    { "source": "/blog", "destination": "https://quantura-ssr.vercel.app/blog" },
    { "source": "/ticker/:path*", "destination": "https://quantura-ssr.vercel.app/ticker/:path*" },
    { "source": "/ticker", "destination": "https://quantura-ssr.vercel.app/ticker" }
  ],
  "headers": [
    { "source": "/(.*).js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }] },
    { "source": "/(.*).css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }] },
    { "source": "/(.*).(svg|png|jpg|jpeg|webp|avif|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] },
    { "source": "/(.*).(woff|woff2)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/site.webmanifest", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] },
    { "source": "/blog/rss.xml", "headers": [{ "key": "Cache-Control", "value": "public, max-age=900, stale-while-revalidate=3600" }] }
  ]
}
