# Quantura market-data service environment template
# No secrets required for Yahoo Finance access.

# Cache TTLs
MARKET_DATA_QUOTE_TTL_SECONDS=90
MARKET_DATA_FAST_INFO_TTL_SECONDS=300
MARKET_DATA_FULL_INFO_TTL_SECONDS=900
MARKET_DATA_FX_TTL_SECONDS=90

# Throughput limits
MARKET_DATA_MAX_TICKERS=25
MARKET_DATA_INFO_WORKERS=4
MARKET_DATA_YAHOO_CONCURRENCY=4
MARKET_DATA_CACHE_MAX_ENTRIES=4096

# CORS origins
# Use * for public endpoint, or comma-separated allowlist for tighter control.
MARKET_DATA_CORS_ORIGINS=*
