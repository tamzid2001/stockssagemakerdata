{
  "name": "quantura-explore-functions",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gcp-build": "npm run build",
    "start": "functions-framework --target=quanturaExploreApi --signature-type=http --source=dist/index.js --port=8080",
    "dev": "npm run build && npm run start"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.4.0",
    "google-auth-library": "^9.15.1",
    "stripe": "^20.4.0"
  },
  "devDependencies": {
    "@google-cloud/functions-framework": "^3.5.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.1",
    "typescript": "^5.8.3"
  }
}
