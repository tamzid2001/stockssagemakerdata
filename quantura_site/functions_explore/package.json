{
  "name": "quantura-explore-functions",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/dataIntegrations.test.js dist/predictionAnalysis.test.js dist/forecastPriceAlerts.test.js dist/quantScreener.test.js",
    "gcp-build": "npm run build",
    "start": "functions-framework --target=quanturaExploreApi --signature-type=http --source=dist/index.js --port=8080",
    "dev": "npm run build && npm run start"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/client-sagemaker": "^3.922.0",
    "@aws-sdk/client-sts": "^3.1116.0",
    "@google-cloud/secret-manager": "^6.0.0",
    "@vercel/oidc-aws-credentials-provider": "^3.3.5",
    "adm-zip": "^0.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.7.0",
    "google-auth-library": "^9.15.1",
    "helmet": "8.1.0",
    "stripe": "^20.4.0"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "fast-xml-parser": "^5.7.2",
    "node-forge": "^1.4.0",
    "path-to-regexp": "0.1.13"
  },
  "devDependencies": {
    "@google-cloud/functions-framework": "^3.5.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.1",
    "typescript": "^5.8.3"
  }
}
